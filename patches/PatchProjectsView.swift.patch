+
+    /// Remove stale mappings and historical duplicate local IDs.
+    /// Keep the first remote item in current catalog order; later colliding
+    /// records will be re-downloaded and receive a deterministic local UUID.
+    func repairMappings(validRemoteIDs: Set<String>, preferredOrder: [String]) {
+        var changed = false
+
+        for remoteID in Array(remoteToLocal.keys) where !validRemoteIDs.contains(remoteID) {
+            remoteToLocal.removeValue(forKey: remoteID)
+            changed = true
+        }
+
+        var ownerByLocalID: [String: String] = [:]
+        for remoteID in preferredOrder {
+            guard let localID = remoteToLocal[remoteID] else { continue }
+            if ownerByLocalID[localID] == nil {
+                ownerByLocalID[localID] = remoteID
+            } else {
+                remoteToLocal.removeValue(forKey: remoteID)
+                changed = true
+            }
+        }
+
+        if changed {
+            UserDefaults.standard.set(remoteToLocal, forKey: mappingKey)
+            objectWillChange.send()
+        }
+    }
